# RunPod Serverless Voice Pipeline Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED: LangGraph Server URL
# =============================================================================
# URL to your LangGraph server (OpenAI-compatible endpoint)
# - Local testing: Use ngrok URL (e.g., https://abc123.ngrok.io)
# - Production: Use Railway/deployed URL (e.g., https://your-app.railway.app)
LANGGRAPH_URL=https://your-langgraph-server.com

# =============================================================================
# OPTIONAL: Override via job input
# =============================================================================
# These can also be passed in the job input JSON:
# {
#   "input": {
#     "room_url": "https://your-domain.daily.co/room-name",
#     "token": "eyJ...",
#     "system_prompt": "You are a helpful assistant...",
#     "voice_reference_path": "/app/voices/reference.wav",
#     "langgraph_url": "https://override-url.com",  <-- overrides LANGGRAPH_URL
#     "user_id": "uuid-of-user",                    <-- for tool access control
#     "session_id": "uuid-of-session"              <-- for conversation continuity
#   }
# }
#
# user_id: Passed to LangGraph tools for filtering data by user
# session_id: Used as thread_id in LangGraph for maintaining conversation history

# =============================================================================
# DEPRECATED: No longer needed (we use LangGraph instead of Anthropic directly)
# =============================================================================
# ANTHROPIC_API_KEY=sk-ant-...
