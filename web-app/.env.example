# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# RunPod Voice Pipeline (server-side only)
# Get API key from: https://www.runpod.io/console/user/settings
RUNPOD_API_KEY=your-runpod-api-key
# Your endpoint ID from RunPod serverless dashboard (e.g., conjanx6nmwq)
RUNPOD_ENDPOINT_ID=your-runpod-endpoint-id

# Daily.co Configuration (optional - for private rooms)
# Get from: https://dashboard.daily.co/developers
# DAILY_API_KEY=your-daily-api-key
