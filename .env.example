# =============================================================================
# PROJECT ME - DOCKER ENVIRONMENT CONFIGURATION
# =============================================================================
# Place this file as .env in the root directory (same level as docker-compose.yml)
# 
# For deployment: Copy your actual keys here
# For development: Each service can also have its own .env file
# =============================================================================

# Limitless AI Configuration
# Get your API key from Limitless settings
LIMITLESS_API_KEY=sk-...

# Anthropic Claude API (Required for LangGraph)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api.....

# LINE Messaging API Configuration
# Create LINE Official Account and Messaging API channel
# Get channel access token from LINE Developers Console
LINE_CHANNEL_ACCESS_TOKEN=...
# Your LINE user ID (get using the get_line_user_id.py script)
LINE_USER_ID=...

# LangGraph Configuration (Docker Internal)
# Don't change these for Docker deployment
LANGGRAPH_URL=http://langgraph-server:2024
LANGGRAPH_ASSISTANT_ID=agent

# Optional: LangSmith (for debugging/monitoring)
# LANGSMITH_API_KEY=your_langsmith_key_here