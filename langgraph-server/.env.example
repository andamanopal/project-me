# Limitless API Key
LIMITLESS_API_KEY=sk-...

ANTHROPIC_API_KEY=sk-ant-api....
# LINE Messaging API Configuration (for push messages and webhooks)
LINE_CHANNEL_ACCESS_TOKEN=your-line-messaging-channel-access-token
LINE_CHANNEL_SECRET=your-line-messaging-channel-secret
# Your LINE user ID (can be found in LINE Developers Console or webhook events)
LINE_USER_ID=your-line-user-id

# LINE Login OAuth Configuration (for user authentication)
LINE_LOGIN_CHANNEL_ID=your-line-login-channel-id
LINE_LOGIN_CHANNEL_SECRET=your-line-login-channel-secret
LINE_CALLBACK_URL=http://localhost:3000/line/callback

# Supabase Configuration
SUPABASE_URL=http://localhost:54321
SUPABASE_PUBLISHABLE_KEY=your-supabase-service-role-key

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:3000

# RAG / Elasticsearch Configuration
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=lifelogs
VOYAGE_API_KEY=your-voyage-api-key
VOYAGE_EMBEDDING_MODEL=voyage-3.5

# Set to "true" to enable chunking (1024 tokens), "false" to index whole documents
USE_CHUNKING=false